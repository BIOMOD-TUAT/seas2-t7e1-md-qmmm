# ChimeraX command file. run from a folder that has struct/ (pdb) and cube/ next to it
close
set bgColor black
lighting simple
lighting depthCue false
graphics silhouettes false
open struct/complex_R.pdb
hide #1 target ab
cartoon #1
cartoon style #1 width 1.4 thickness 0.3
nucleotides #1 fill
color #1 & protein rgb(50,78,110)
color #1 & nucleic rgb(90,72,28)
show #1 & nucleic & ~H & #1@@occupancy<0.5 target ab
style #1 & nucleic & ~H & #1@@occupancy<0.5 stick
size #1 & nucleic & ~H & #1@@occupancy<0.5 stickRadius 0.2
show #1@@occupancy>0.5 target a
style #1@@occupancy>0.5 sphere
color #1@@occupancy>0.5 byhetero
color #1@@occupancy>0.5 & C white
color #1@@occupancy>0.5 & P orange
show #1@@bfactor>2.5 target a
style #1@@bfactor>2.5 sphere
color #1@@bfactor>2.5 purple
view
